<?xml version="1.0" encoding="utf-8"?>
<!--
  列表页右上角溢出菜单。背景直接复用主题里的 fwCardBackground，
  圆角/描边/深浅色都跟列表卡片保持一致，不额外造一套视觉。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/fwCardBackground"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/row_show_system"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ac_show_system"
            android:textColor="?attr/fwTextPrimary"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/cb_show_system"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent_1"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_sort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ac_sort"
            android:textColor="?attr/fwTextPrimary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_sort_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_value_name"
            android:textColor="?attr/fwTextHint"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:includeFontPadding="false"
            android:text="›"
            android:textColor="?attr/fwTextSecondary"
            android:textSize="20sp" />
    </LinearLayout>

</LinearLayout>
